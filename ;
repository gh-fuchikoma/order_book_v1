#include "order_book.hpp"
#include <optional>
#include <print>

void OrderBook::add_order(const Order &order) {
  std::println("received order_id: {}", order.id);
  if (order.side == Side::Buy) {
    bids[order.price].orders.push_back(order);
    bids[order.price].total_quantity += order.quantity;
  } else {
    asks[order.price].orders.push_back(order);
    asks[order.price].total_quantity += order.quantity;
  }
}

std::optional<Price> OrderBook::best_bid() {
  if (bids.empty())
    return std::nullopt;

  auto [price, _] = *bids.begin();
  return price;
}

std::optional<Price> OrderBook::best_ask() {
  if (asks.empty())
    return std::nullopt;

  auto [price, _] = *asks.begin();
  return price;
}

void OrderBook::match_order(Order order) {
  if (order.side == Side::Buy) {
    Price ask_price = best_ask().value();
    if (ask_price <= order.price) {
      OrderQueue &order_queue = asks[ask_price].orders;
      while (order.quantity > 0 && !order_queue.empty()) {
        Order &resting = order_queue.front();
        if (resting.quantity > order.quantity) {
          resting.quantity -= order.quantity;
          order.quantity = 0;
        } else {
          order.quantity -= resting.quantity;
          order_queue.pop_front();
        }
      }
      if (order.quantity > 0) {
        add_order(order);
      }
    }
  }
}

